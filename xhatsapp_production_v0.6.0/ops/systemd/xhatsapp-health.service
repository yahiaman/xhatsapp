[Unit]
Description=Supervision locale Xhatsapp
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/opt/xhatsapp/scripts/health-xhatsapp.sh
User=root
Group=root
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/xhatsapp-monitor
